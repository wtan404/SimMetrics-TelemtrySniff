<UserControl x:Class="SimMetrics.TelemetrySniff.UI.SniffPluginUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="800"
             Background="#1E1E1E" Foreground="#FFFFFF" FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="SimMetrics Telemetry Sniffer" FontSize="24" FontWeight="SemiBold" Foreground="#3890E6"/>
            <TextBlock Text="Capture, catalog, and map raw simulator telemetry broadcasts across AMS2, iRacing, Assetto Corsa, BeamNG, and more."
                       FontSize="13" Foreground="#AAAAAA" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Status & Controls Card -->
        <Border Grid.Row="1" Background="#282828" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Target Simulator: " FontWeight="Bold" Foreground="#888888"/>
                        <TextBlock x:Name="TxtGameName" Text="No game running" FontWeight="Bold" Foreground="#FFD700" Margin="6,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Status: " FontWeight="Bold" Foreground="#888888"/>
                        <TextBlock x:Name="TxtStatus" Text="Idle" FontWeight="SemiBold" Foreground="#00FF66" Margin="6,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Frames Captured: " FontWeight="Bold" Foreground="#888888"/>
                        <TextBlock x:Name="TxtFrames" Text="0" Foreground="#FFFFFF" Margin="6,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Discovered Channels: " FontWeight="Bold" Foreground="#888888"/>
                        <TextBlock x:Name="TxtPropertiesCount" Text="0" Foreground="#FFFFFF" Margin="6,0,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                    <Button x:Name="BtnStart" Content="Start Sniffing" Click="BtnStart_Click"
                            Background="#007ACC" Foreground="White" Padding="16,8" Margin="0,0,8,0" FontWeight="Bold"/>
                    <Button x:Name="BtnStop" Content="Stop &amp; Export" Click="BtnStop_Click"
                            Background="#AA3333" Foreground="White" Padding="16,8" IsEnabled="False" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Configuration Settings Card -->
        <Border Grid.Row="2" Background="#282828" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Capture Configuration" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Sampling Frequency (Hz):" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" x:Name="SliderHz" Minimum="1" Maximum="60" Value="30" TickFrequency="5"
                            IsSnapToTickEnabled="True" ValueChanged="SliderHz_ValueChanged" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" x:Name="TxtHz" Text="30 Hz" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Grid>

                <CheckBox x:Name="ChkRawPayload" Content="Capture Game Raw Buffers (e.g. iRacing VarHeaders, PC2 SharedMemory, OutGauge)"
                          IsChecked="True" Margin="0,4,0,8" Foreground="White" Checked="ChkConfig_Changed" Unchecked="ChkConfig_Changed"/>
                <CheckBox x:Name="ChkDynamicProps" Content="Capture Dynamic SimHub Properties Registry (Auto-discovery of all exposed channels)"
                          IsChecked="True" Margin="0,0,0,12" Foreground="White" Checked="ChkConfig_Changed" Unchecked="ChkConfig_Changed"/>

                <TextBlock Text="Output Directory:" Margin="0,0,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="TxtOutputDir" IsReadOnly="True" Background="#181818" Foreground="#E0E0E0" Padding="6"/>
                    <Button Grid.Column="1" Content="Open Folder" Click="BtnOpenFolder_Click" Margin="8,0,0,0" Padding="12,4"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Info / Tip Footer -->
        <Border Grid.Row="3" Background="#222222" CornerRadius="8" Padding="16">
            <StackPanel>
                <TextBlock Text="💡 Tips for Mapping Future Projects" FontWeight="Bold" Margin="0,0,0,6" Foreground="#3890E6"/>
                <TextBlock Text="1. When you Stop Sniffing, two files are created: a .jsonl stream containing continuous telemetry frames, and a .catalog.json file detailing all discovered properties and their data types."
                           TextWrapping="Wrap" Foreground="#CCCCCC" Margin="0,0,0,4"/>
                <TextBlock Text="2. Map steering, wheel slip, suspension travel, and engine maps across games by comparing the normalized packet alongside the game-specific raw payload."
                           TextWrapping="Wrap" Foreground="#CCCCCC"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
