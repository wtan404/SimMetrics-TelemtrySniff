<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>SimMetryxObserver</AssemblyName>
    <RootNamespace>SimMetryx.TelemetrySniff</RootNamespace>
    <OutputType>Library</OutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <SimHubDir Condition="'$(SimHubDir)' == '' and Exists('D:\Program Files\SimHub\SimHub.Plugins.dll')">D:\Program Files\SimHub</SimHubDir>
    <SimHubDir Condition="'$(SimHubDir)' == '' and Exists('C:\Program Files (x86)\SimHub\SimHub.Plugins.dll')">C:\Program Files (x86)\SimHub</SimHubDir>
    <SimHubDir Condition="'$(SimHubDir)' == ''">D:\Program Files\SimHub</SimHubDir>
    <DefineConstants Condition="Exists('$(SimHubDir)\SimHub.Plugins.dll')">$(DefineConstants);SIMHUB_REAL</DefineConstants>
    <DefaultItemExcludes>$(DefaultItemExcludes);SimMetryx.TelemetrySniff.Core\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(SimHubDir)\SimHub.Plugins.dll')">
    <Reference Include="SimHub.Plugins">
      <HintPath>$(SimHubDir)\SimHub.Plugins.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="GameReaderCommon">
      <HintPath>$(SimHubDir)\GameReaderCommon.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="SimHub.Logging">
      <HintPath>$(SimHubDir)\SimHub.Logging.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="MahApps.Metro">
      <HintPath>$(SimHubDir)\MahApps.Metro.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="log4net">
      <HintPath>$(SimHubDir)\log4net.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="SimHubStubs\**" Condition="Exists('$(SimHubDir)\SimHub.Plugins.dll')" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="SimMetryx.TelemetrySniff.Core\**\*.cs" Exclude="SimMetryx.TelemetrySniff.Core\obj\**;SimMetryx.TelemetrySniff.Core\bin\**" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(OS)' == 'Windows_NT' And Exists('$(SimHubDir)')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(SimHubDir)" ContinueOnError="true" />
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(SimHubDir)\simmetryxObserver.dll" ContinueOnError="true" />
  </Target>

</Project>
