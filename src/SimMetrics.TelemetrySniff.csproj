<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>SimMetrics.TelemetrySniff</AssemblyName>
    <RootNamespace>SimMetrics.TelemetrySniff</RootNamespace>
    <OutputType>Library</OutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <SimHubDir Condition="'$(SimHubDir)' == ''">C:\Program Files (x86)\SimHub</SimHubDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- SimHub Core Assemblies (Private=False ensures they are not copied to build output) -->
    <Reference Include="SimHub.Plugins" Condition="Exists('$(SimHubDir)\SimHub.Plugins.dll')">
      <HintPath>$(SimHubDir)\SimHub.Plugins.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="GameManager" Condition="Exists('$(SimHubDir)\GameManager.dll')">
      <HintPath>$(SimHubDir)\GameManager.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="WPFAspects" Condition="Exists('$(SimHubDir)\WPFAspects.dll')">
      <HintPath>$(SimHubDir)\WPFAspects.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="MahApps.Metro" Condition="Exists('$(SimHubDir)\MahApps.Metro.dll')">
      <HintPath>$(SimHubDir)\MahApps.Metro.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="log4net" Condition="Exists('$(SimHubDir)\log4net.dll')">
      <HintPath>$(SimHubDir)\log4net.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- Post-build event helper to copy DLL directly to SimHub plugin directory when building on Windows -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(OS)' == 'Windows_NT' And Exists('$(SimHubDir)')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(SimHubDir)" ContinueOnError="true" />
  </Target>

</Project>
