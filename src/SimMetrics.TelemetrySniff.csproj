<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net48</TargetFrameworks>
    <AssemblyName>SimMetrics.TelemetrySniff</AssemblyName>
    <RootNamespace>SimMetrics.TelemetrySniff</RootNamespace>
    <OutputType>Library</OutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <SimHubDir Condition="'$(SimHubDir)' == ''">C:\Program Files (x86)\SimHub</SimHubDir>
    <DefineConstants Condition="Exists('$(SimHubDir)\SimHub.Plugins.dll')">$(DefineConstants);SIMHUB_REAL</DefineConstants>
    <DefaultItemExcludes>$(DefaultItemExcludes);SimMetrics.TelemetrySniff.Core\**;SimMetrics.TelemetrySniff.Cli\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(SimHubDir)\SimHub.Plugins.dll')">
    <Reference Include="SimHub.Plugins">
      <HintPath>$(SimHubDir)\SimHub.Plugins.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="GameManager">
      <HintPath>$(SimHubDir)\GameManager.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="WPFAspects">
      <HintPath>$(SimHubDir)\WPFAspects.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="MahApps.Metro">
      <HintPath>$(SimHubDir)\MahApps.Metro.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="log4net">
      <HintPath>$(SimHubDir)\log4net.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="SimHubStubs\**" Condition="Exists('$(SimHubDir)\SimHub.Plugins.dll')" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="SimMetrics.TelemetrySniff.Core\SimMetrics.TelemetrySniff.Core.csproj" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- Post-build event helper to copy DLL directly to SimHub plugin directory when building on Windows -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(OS)' == 'Windows_NT' And Exists('$(SimHubDir)')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(SimHubDir)" ContinueOnError="true" />
  </Target>

</Project>
